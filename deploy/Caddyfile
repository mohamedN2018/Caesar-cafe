# Caesar Cafe behind Dokploy.
#
# The difference from `deploy/Caddyfile` is one thing and it matters: **Caddy does
# not terminate TLS here.** Dokploy runs Traefik, Traefik holds the certificate for
# the domain and speaks to this container over plain HTTP on the internal network.
# Two things trying to obtain a certificate for one hostname is how you get an ACME
# rate-limit and an outage, so this listens on :80 with `auto_https off` and Traefik
# is the only thing talking to Let's Encrypt.
#
# Everything else is deliberately identical to the bare-host Caddyfile: the same
# security headers, the same SPA fallback, the same cache rules, the same refusal
# to cache `index.html`. A deployment that quietly relaxed its headers because it
# went through a different proxy would be the worst kind of difference — invisible
# until somebody audits it.
{
	auto_https off
	admin off
}

(security_headers) {
	header {
		# HSTS is set HERE and not by Traefik, because this is the app that knows
		# it is only ever served over TLS. Traefik adding it would work; both
		# adding it produces a duplicate header, and neither adding it is a
		# downgrade nobody notices.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"

		# The SPA loads nothing from anywhere else. `connect-src 'self'` is what
		# stops an injected script exfiltrating to another host — and it holds only
		# because the API is same-origin through the `/api/*` handler below.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		-Server
		-X-Powered-By
	}
}

:80 {
	import security_headers
	encode zstd gzip

	# Dokploy's own health probe. Answered by Caddy directly so a probe never
	# depends on the database being up — a container restarted because Postgres
	# was briefly slow is a restart loop, not a recovery.
	handle /healthz {
		respond "ok" 200
	}

	# ── API ──────────────────────────────────────────────────────────────────
	handle /api/* {
		# Django refuses an oversized product photo in the serializer, but only
		# after the multipart parser has written the whole thing to a temp file.
		# This is the only place that can refuse a body without receiving it.
		request_body {
			max_size 10MB
		}

		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
			# Traefik terminated TLS, so Django must be told the original scheme or
			# `SECURE_SSL_REDIRECT` sends the browser round a redirect loop.
			header_up X-Forwarded-Proto https

			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	# WebSockets for the kitchen display. Same upstream; Caddy upgrades in place.
	handle /ws/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle /static/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle /media/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# ── the SPA ──────────────────────────────────────────────────────────────
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		# index.html must never be cached: it points at the hashed asset bundles,
		# so a cached copy pins a browser to a deployment that no longer exists.
		@html path *.html /
		header @html Cache-Control "no-cache, must-revalidate"

		# The service worker must not be cached either, or a browser keeps serving
		# last week's offline shell after a deploy.
		@sw path /sw.js
		header @sw Cache-Control "no-cache, must-revalidate"
	}

	log {
		output stdout
		format json
	}
}
