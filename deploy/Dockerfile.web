# The SPA, built and then served by Caddy.
#
# On a bare host the runbook builds the bundle with a one-off `docker run node`
# and mounts `frontend/dist` into Caddy. Dokploy has no host to run that on — it
# clones the repo and brings the compose file up — so the build has to happen
# inside the image.
#
# Two stages, and the second one carries no Node at all. A production container
# that ships a package manager and a compiler is a larger attack surface for no
# benefit, and this one only ever hands out static files.

# ── build ────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

# Lockfile first, so a change to source does not invalidate the dependency layer.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Relative, not an absolute origin. Caddy proxies `/api/*` to the api service on
# the same host, so the browser never makes a cross-origin request — which is why
# `connect-src 'self'` in the CSP is enough to stop an injected script from
# exfiltrating anywhere.
ENV VITE_API_BASE_URL=/api/v1

# `npm run build` is `vue-tsc --noEmit && vite build`: a type error fails the
# image rather than shipping a bundle nobody type-checked.
RUN npm run build

# ── serve ────────────────────────────────────────────────────────────────────
FROM caddy:2-alpine

COPY deploy/Caddyfile.dokploy /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv/web

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/healthz || exit 1
