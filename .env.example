# ─────────────────────────────────────────────────────────────────────────────
# Caesar Cafe — environment template
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Host ports (dev only) ────────────────────────────────────────────────────
# Change these if another project already owns the default port on your machine.
API_PORT=8000
FRONTEND_PORT=5173

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.localhost

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=caesar
POSTGRES_USER=caesar
POSTGRES_PASSWORD=caesar_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://caesar:caesar_dev_password@postgres:5432/caesar

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ──────────────────────────────────────────────────────────────────────
# Rotating this invalidates every issued token.
JWT_SIGNING_KEY=dev-insecure-jwt-key-change-me
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_DEVICE_TOKEN_MINUTES=60

# ── Licensing ────────────────────────────────────────────────────────────────
# LICENSE_PEPPER must NEVER be rotated — every issued license key becomes
# unverifiable and there is no recovery path (plaintext keys are not stored).
# Back it up separately from the database.
LICENSE_PEPPER=dev-insecure-pepper-change-me
# Ed25519 private key (base64) used to sign offline license tokens.
# Generate: python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; \
#   from cryptography.hazmat.primitives import serialization as s; import base64; \
#   k=Ed25519PrivateKey.generate(); \
#   print(base64.b64encode(k.private_bytes(s.Encoding.Raw, s.PrivateFormat.Raw, s.NoEncryption())).decode())"
LICENSE_SIGNING_KEY=

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json

# ── Frontend ─────────────────────────────────────────────────────────────────
# In development, docker-compose derives VITE_API_BASE_URL from API_PORT above,
# so there is nothing to keep in sync here. Set this only for a production build
# against a real domain.
# VITE_API_BASE_URL=https://api.caesar-cafe.example/api/v1

# ── Production only ──────────────────────────────────────────────────────────
# DOMAIN=caesar-cafe.example
# ACME_EMAIL=ops@caesar-cafe.example
# BACKUP_ENCRYPTION_KEY=
