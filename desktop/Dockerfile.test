# Test-only image for the Desktop client.
#
# The shipped application is a Windows .exe built with PyInstaller; this exists
# so CI and developers can run the logic and widget tests on Linux, headless,
# via Qt's offscreen platform plugin.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    QT_QPA_PLATFORM=offscreen

WORKDIR /app

# Qt needs these shared libraries even when rendering offscreen.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libgl1 \
        libegl1 \
        libdbus-1-3 \
        libxkbcommon0 \
        libfontconfig1 \
        libfreetype6 \
        libx11-6 \
        libxext6 \
        libxrender1 \
        libxcb1 \
        libxcb-cursor0 \
        libxcb-shape0 \
        libxcb-xfixes0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN mkdir -p src/caesar_pos && touch src/caesar_pos/__init__.py \
    && pip install --upgrade pip && pip install -e ".[dev]"

COPY . .

CMD ["pytest", "-q"]
